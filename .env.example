DB_HOST=127.0.0.1
DB_HOST_FOR_CONTAINER=host.docker.internal
DB_PORT=3306
DB_NAME=startingblock
DB_USERNAME=root
DB_PASSWORD=startingblock

SERVER_PORT=18200
AI_RAG_PYTHON_EXECUTABLE=python3
AI_RAG_WORKING_DIRECTORY=/app/ai-rag
AI_RAG_CLI_TIMEOUT_SECONDS=600
SPRING_MVC_ASYNC_REQUEST_TIMEOUT=600000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:18200,https://www.startingblock.co.kr,https://startingblock-api.newlearn.ai.kr
APP_AUTH_TOKEN_SECRET=change-me-local-token-secret-change-me
APP_AUTH_ACCESS_TOKEN_EXPIRATION_MSEC=3600000
APP_AUTH_REFRESH_TOKEN_EXPIRATION_MSEC=1209600000
APP_OAUTH2_AUTHORIZED_REDIRECT_URIS=http://localhost:3000/oauth2/redirect,myandroidapp://oauth2/redirect,myiosapp://oauth2/redirect

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://startingblock-api.newlearn.ai.kr/login/oauth2/code/kakao
KAKAO_ADMIN_KEY=
OPEN_DATA_SERVICE_KEY=
BIZ_INFO_SERVICE_KEY=
GPT_API_KEY=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

MINIO_ENDPOINT=host.docker.internal:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=startingblock-pdfgpt
MINIO_PROCESSED_PREFIX=processed
MINIO_RAW_PREFIX=raw

QDRANT_COLLECTION_NAME=announcement_chunks
QDRANT_API_KEY=

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_KEEP_ALIVE=60s
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=768
OLLAMA_THINK=true
OLLAMA_SCHED_SPREAD=true
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40
OLLAMA_REPEAT_PENALTY=1.05
OLLAMA_MODEL_IDLE_SECONDS=60
OLLAMA_IDLE_SWEEP_INTERVAL_SECONDS=5

REDIS_URL=redis://proxy:6379/0
LLM_GENERATION_STATUS_TTL_SECONDS=86400
LLM_DYNAMIC_CONCURRENCY_ENABLED=true
LLM_DYNAMIC_MAX_CONCURRENCY=0
LLM_DYNAMIC_REQUEST_MEMORY_MB=4096
LLM_DYNAMIC_WAIT_INTERVAL_MS=1000
LLM_GPU_MAX_UTILIZATION=92
LLM_GPU_MIN_FREE_MEMORY_MB=2048
LLM_GPU_MAX_MEMORY_USAGE_PERCENT=88
LLM_GPU_WAIT_TIMEOUT_SECONDS=600

LLM_IDLE_ARCHIVE_SECONDS=1200
LLM_ARCHIVE_SWEEP_INTERVAL_SECONDS=60
LLM_HISTORY_MAX_TURNS=4
LLM_SUMMARY_TRIGGER_MESSAGES=16
LLM_SUMMARY_RECENT_MESSAGES=8
LLM_SUMMARY_MAX_CHARS=3000

EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-large-instruct
EMBEDDING_MODEL_REPO_ID=intfloat/multilingual-e5-large-instruct
EMBEDDING_MODEL_LOCAL_PATH=/data/embedding-models/intfloat__multilingual-e5-large-instruct
EMBEDDING_DEVICE=cuda
RAG_TOP_K=5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_CONTEXT_MAX_CHARS=4000
INDEXING_POLL_INTERVAL_SECONDS=2
INDEXING_BATCH_SIZE=16

JPA_DDL_AUTO=validate
HIBERNATE_FORMAT_SQL=true
HIBERNATE_SHOW_SQL=true
SERVER_ERROR_INCLUDE_EXCEPTION=true
SERVER_ERROR_INCLUDE_STACKTRACE=always
SWAGGER_TRY_IT_OUT_ENABLED=true
SWAGGER_FILTER=true
SWAGGER_DISPLAY_REQUEST_DURATION=true
LOGGING_LEVEL_HIBERNATE_SQL=debug
LOGGING_LEVEL_FEIGN=debug
